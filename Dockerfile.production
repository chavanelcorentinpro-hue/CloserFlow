FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8787
ENV CLOSERFLOW_DATA_DIR=/var/lib/closerflow
COPY package*.json ./
RUN npm ci --omit=dev
COPY server ./server
RUN mkdir -p /var/lib/closerflow && chown -R node:node /var/lib/closerflow /app
USER node
EXPOSE 8787
VOLUME ["/var/lib/closerflow"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:8787/api/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node","server/index.mjs"]
